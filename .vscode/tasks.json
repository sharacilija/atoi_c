{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C File",
            "type": "shell",
            "command": "C:/msys64/mingw64/bin/gcc.exe",
            "args": [
                "-Wall",
                "-Wextra",
                "-std=c17",
                "my_atoi.c",
                "-o",
                "my_atoi.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}